# swap:e2e / bridge:fill
BRIDGE_AMOUNT=""        # raw BONK before decimal scaling (default: 1000)
INPUT_AMOUNT=""         # USDC in 6-dec units to lock (default: 100000 = 0.1 USDC)
DESIRED_OUTPUT=""       # raw wBONK wanted (default: BRIDGE_AMOUNT × 10^decimals)
MIN_OUTPUT=""           # floor wBONK (default: 90% of desiredOutput)
AUCTION_SECONDS=""      # auction duration in seconds (default: 300)
INTENT_ID=""            # 0x-prefixed bytes32 — only needed for bridge:fill (not swap:e2e)
INPUT_RECIPIENT=""      # solver's Base address to receive USDC (default: DEPLOYER_KEY address)
RELAY_GAS_LIMIT=""      # optional, default 400000
FILL_TIMEOUT_MS=""      # max wait for fill event in ms (default: 300000 = 5 min)
